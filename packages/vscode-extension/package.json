{
  "name": "commit-rag-vscode",
  "displayName": "commit-rag: AI Commit Message Generator",
  "version": "0.0.0",
  "private": true,
  "description": "Generate commit messages from staged diffs, powered by RAG over your repo's own commit history.",
  "publisher": "commit-rag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/commit-rag/commit-rag"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "commit",
    "message",
    "ai",
    "rag",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commit-rag.generateMessage",
        "title": "Generate AI Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "commit-rag.reindex",
        "title": "commit-rag: Rebuild Commit Index"
      },
      {
        "command": "commit-rag.configureKeys",
        "title": "commit-rag: Configure API Keys"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commit-rag.generateMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node esbuild.config.mjs",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "package": "node esbuild.config.mjs && vsce package --no-dependencies && tsc"
  },
  "dependencies": {
    "@commit-rag/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
